# Keeps formatting consistent between the Python and JavaScript halves of the
# repo, which use different indent widths. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4

[*.{js,jsx,json,css,html,yml,yaml,toml}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses trailing double-spaces as a hard line break.
trim_trailing_whitespace = false

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab
