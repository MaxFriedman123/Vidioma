# Vidioma backend environment. Copy to `.env` (git-ignored) and fill in.
# Every var is optional unless noted; the app degrades gracefully when one is
# unset (caching off, progress features off, unthrottled, etc.).

# ── Translation ────────────────────────────────────────────────────────────
# DeepL API key. Ends in ":fx" for the free tier (routes to api-free.deepl.com);
# otherwise the paid endpoint. Unset -> DeepL is skipped, cascade falls back to
# the free scraped engines.
DEEPL_API_KEY=

# ── Cache (Redis) ──────────────────────────────────────────────────────────
# Unset -> caching disabled (app still works, just slower + more API calls).
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400

# ── Auth + user data (Supabase) ────────────────────────────────────────────
# Unset -> progress/classes/assignments features are disabled.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=       # service-role key (bypasses RLS) — keep secret
SUPABASE_JWT_SECRET=        # only used for the HS256 fallback when JWKS is unavailable

# ── Caption egress (see docs/caption-egress.md) ────────────────────────────
# Route the server-side caption LIST through a clean-egress proxy (e.g. WARP)
# when the host IP is YouTube-blocked. Unset -> direct connection.
CAPTION_PROXY_URL=          # e.g. socks5h://127.0.0.1:25344

# ── Rate limiting (abuse / DeepL-quota protection) ─────────────────────────
# RATE_LIMIT_ENABLED=0 disables entirely. Limits are "<n> per <period>" and can
# be combined with ";". Raise these for a classroom behind a single NAT IP.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_DEFAULT=240 per hour;60 per minute
RATE_LIMIT_TRANSCRIPT=30 per minute;300 per hour
RATE_LIMIT_TRANSLATE=30 per minute;300 per hour
RATE_LIMIT_CAPTION_TRACKS=60 per minute;600 per hour
MAX_CONTENT_LENGTH_BYTES=8388608   # 8 MB hard cap on request body size

# ── Admin + server ─────────────────────────────────────────────────────────
# ADMIN_API_KEY gates the cache-clear admin endpoint; unset -> endpoint disabled.
ADMIN_API_KEY=
PORT=5000
FLASK_ENV=                  # set to "development" for debug mode locally
