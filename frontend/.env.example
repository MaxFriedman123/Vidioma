# Vidioma frontend environment. Copy to `.env` (git-ignored) and fill in.
#
# Create React App only exposes vars prefixed REACT_APP_, and it INLINES them at
# build time. So these are baked into the bundle and are public: never put a
# secret here (the Supabase anon key is designed to be public; the service-role
# key belongs in the backend only).
#
# Precedence gotcha: `.env.local` overrides `.env`, and both override the shell
# environment for CRA. If a value seems to be ignored, check for a stale
# `.env.local`.

# ── Backend ────────────────────────────────────────────────────────────────
# Base URL of the Flask backend. Unset -> http://localhost:5000.
REACT_APP_API_URL=http://localhost:5000

# ── Caption egress (see docs/caption-egress.md) ────────────────────────────
# Optional Cloudflare Worker relay (cloudflare-worker/). When set, the browser
# lists caption tracks through it first, since its Cloudflare egress isn't
# YouTube-IP-blocked the way a datacenter host is. Unset -> the browser goes
# straight to the backend's /api/caption-tracks.
REACT_APP_CAPTION_RELAY_URL=

# ── Auth (Supabase) ────────────────────────────────────────────────────────
# Enables the login / signup / dashboard / classes UI. Must point at the SAME
# Supabase project the backend uses. Unset -> auth features are hidden and the
# app runs in anonymous practice mode (progress kept in localStorage).
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
